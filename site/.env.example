# ── Navegador (públicas por design; a segurança vem do RLS) ──
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Somente servidor (Vercel > Settings > Environment Variables). NUNCA com prefixo VITE_ ──
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# JSON da service account do Google (pode ser o JSON puro ou em base64). Compartilhe a pasta do Drive com o e-mail dela (Leitor).
GOOGLE_SERVICE_ACCOUNT_JSON=
