# ───────── Copie para .env.local (desenvolvimento) e configure o mesmo na Vercel (Settings → Environment Variables) ─────────
# NUNCA faça commit de .env.local. Somente variáveis NEXT_PUBLIC_* chegam ao navegador.

# URL do projeto Supabase (Project Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave "anon / public" (Project Settings → API). É pública por desenho: quem protege os dados é o RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ⚠️ SERVIDOR APENAS. Chave "service_role". Usada só em rotas /api (reações) e na ação de convidar admins.
# Nunca coloque em NEXT_PUBLIC_*, no código ou em logs.
SUPABASE_SERVICE_ROLE_KEY=

# Sal secreto para gerar o hash do IP usado no limite de frequência (string longa e aleatória, ex.: `openssl rand -hex 32`).
RATE_LIMIT_SALT=

# URL pública do site (links de compartilhamento, sitemap, Open Graph). Ex.: https://revolution-conference.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
