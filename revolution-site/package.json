{
  "name": "revolution-conference",
  "version": "1.0.0",
  "private": true,
  "description": "Site oficial da Revolution Conference (Next.js + Supabase)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:db": "vitest run --config vitest.db.config.ts",
    "test:e2e": "node tests/e2e/run.mjs",
    "test": "npm run typecheck && npm run test:unit && npm run test:db && npm run test:e2e",
    "tools:postgrest": "node scripts/get-postgrest.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.57.0",
    "next": "^15.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.9",
    "@electric-sql/pglite-socket": "^0.2.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "playwright": "^1.56.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
